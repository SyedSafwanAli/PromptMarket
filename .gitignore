# ===========================================================================
# PromptAtlas — Git ignore policy
#
# Repository boundary: the WordPress root, tracking ONLY project-authored code.
# Decided in Phase 03; reasoning recorded in DECISIONS.md decision 11.
#
# Tracked:   wp-content/themes/promptatlas/
#            wp-content/plugins/promptatlas-core/
#            the documentation set, Prompts/, tooling config
# Ignored:   WordPress core, credentials, uploads, third-party code, build output
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. SECRETS — never commit. This repository has a GitHub remote.
# ---------------------------------------------------------------------------
wp-config.php
wp-config-local.php
*-credentials.txt
*credentials*.txt
.env
.env.*
*.env
auth.json

# ---------------------------------------------------------------------------
# 2. WORDPRESS CORE — installed by WP-CLI, verified by `wp core verify-checksums`.
#    Never modified by this project, so never tracked.
# ---------------------------------------------------------------------------
/wp-admin/
/wp-includes/
/index.php
/license.txt
/readme.html
/wp-activate.php
/wp-blog-header.php
/wp-comments-post.php
/wp-config-sample.php
/wp-cron.php
/wp-links-opml.php
/wp-load.php
/wp-login.php
/wp-mail.php
/wp-settings.php
/wp-signup.php
/wp-trackback.php
/xmlrpc.php

# Generated by WordPress and environment-specific: the local file hardcodes
# `RewriteBase /promptmarket/`, which is wrong everywhere else. Production gets
# its own, written at deploy time (Phase 22).
/.htaccess

# ---------------------------------------------------------------------------
# 3. WP-CONTENT — ignore everything, then re-include only what we author.
#    The `!` rules below are the entire reason this repository is useful.
# ---------------------------------------------------------------------------
wp-content/*
!wp-content/themes/
wp-content/themes/*
!wp-content/themes/promptatlas/
!wp-content/plugins/
wp-content/plugins/*
!wp-content/plugins/promptatlas-core/

# Never track uploads: binary, large, and reproducible from the media library.
wp-content/uploads/
wp-content/upgrade/
wp-content/upgrade-temp-backup/
wp-content/cache/
wp-content/languages/
wp-content/debug.log
wp-content/advanced-cache.php
wp-content/object-cache.php
wp-content/db.php
wp-content/mu-plugins/

# ---------------------------------------------------------------------------
# 4. DATABASE — never committed. See DEPLOYMENT.md for the dump procedure.
# ---------------------------------------------------------------------------
*.sql
*.sql.gz
*.sql.zip
*.sqlite
*.mwb.bak

# ---------------------------------------------------------------------------
# 5. DEPENDENCIES AND BUILD OUTPUT
# ---------------------------------------------------------------------------
/vendor/
node_modules/
.phpcs-cache
.phpunit.result.cache
/tools/.cache/

# ---------------------------------------------------------------------------
# 6. LOGS, BACKUPS, TEMPORARY FILES
# ---------------------------------------------------------------------------
*.log
*.bak
*.tmp
*.orig
*.rej
*~
/backups/

# ---------------------------------------------------------------------------
# 7. EDITOR AND OS NOISE
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# VS Code: keep shared project settings, ignore personal state.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code local state
.claude/settings.local.json
