# PromptAtlas — editor configuration
# Follows the WordPress coding standards. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# WordPress uses real tabs for PHP, CSS and JS indentation.
[*.{php,js,css}]
indent_style = tab
indent_size = 4

# YAML and JSON cannot use tabs.
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
# Trailing whitespace is significant in Markdown (two spaces = line break).
trim_trailing_whitespace = false

[*.{xml,xml.dist}]
indent_style = tab
indent_size = 4

# Windows batch and PowerShell files need CRLF.
[*.{bat,cmd,ps1}]
end_of_line = crlf
